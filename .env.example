ISSUNEXA_POSTGRES_DB=issunexa
ISSUNEXA_POSTGRES_USER=issunexa
ISSUNEXA_POSTGRES_PORT=5432
ISSUNEXA_BACKEND_PORT=8080
# Local-only frontend access; optionally set the bind address to your Tailscale IPv4.
ISSUNEXA_FRONTEND_BIND_ADDRESS=127.0.0.1
ISSUNEXA_FRONTEND_PORT=3000
# Bootstrap administrator: retain these settings for an existing volume.
# Choose three distinct local passwords; never commit the real .env.
ISSUNEXA_POSTGRES_PASSWORD=
ISSUNEXA_FLYWAY_USERNAME=issunexa_migrator
ISSUNEXA_FLYWAY_PASSWORD=
ISSUNEXA_DB_USERNAME=issunexa_runtime
ISSUNEXA_DB_PASSWORD=
